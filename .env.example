# Copy to .env and adjust. Every variable is validated at startup (src/config/env.ts).
NODE_ENV=development
PORT=4000
# Public URL used to build short links, e.g. https://sho.rt
PUBLIC_BASE_URL=http://localhost:4000
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_EXPIRES_IN=1d
# SQLite file path (":memory:" for an ephemeral database)
DATABASE_PATH=./data/app.db
# Comma-separated list of allowed CORS origins, or * for any
CORS_ORIGIN=*
LOG_LEVEL=info
# Number of reverse proxies in front of the app (Render/Fly/Railway = 1)
TRUST_PROXY=1
